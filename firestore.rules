rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /households/{hid} {
      // Members can list/read their own household.
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;

      // Any signed-in user can fetch a household by its exact ID (the invite
      // code) to join it. This does NOT allow listing/browsing households -
      // Firestore only grants this for a direct get(), not a query.
      allow get: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid];

      // A member can update freely. A non-member may only update to add
      // themselves (and only themselves), and only while the household has
      // room (max 2 members).
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (
          resource.data.members.size() < 2
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
        )
      );

      allow delete: if false;

      // Read/update/delete: any household member, for every subcollection.
      // Create is defined per-subcollection below so we can enforce
      // per-document integrity (e.g. transactions.createdBy) - a broader
      // "allow write" here would OR-bypass those checks.
      match /{subcol}/{docId} {
        allow read, update, delete: if request.auth != null
          && request.auth.uid in
             get(/databases/$(db)/documents/households/$(hid)).data.members;
      }

      function isMember() {
        return request.auth != null
          && request.auth.uid in
             get(/databases/$(db)/documents/households/$(hid)).data.members;
      }

      match /categories/{catId} {
        allow create: if isMember();
      }

      match /accounts/{accId} {
        allow create: if isMember();
      }

      match /transactions/{txId} {
        allow create: if isMember()
          && request.resource.data.createdBy == request.auth.uid;
      }
    }
  }
}
