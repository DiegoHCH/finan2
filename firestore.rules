rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function householdPath(hid) {
      return /databases/$(db)/documents/households/$(hid);
    }

    // Only the keys in [keys] differ between the stored and the written doc.
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Single-use, expiring codes a member creates to bring their partner in
    // (see HouseholdRepository.createInvite). Gettable by exact code only -
    // 10 characters (50 bits) and a 7-day life put guessing out of reach.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['householdId', 'createdBy', 'expiresAt',
                                                  'householdName', 'inviterName'])
        // Shown to whoever holds the code before they join.
        && request.resource.data.get('householdName', '') is string
        && request.resource.data.get('householdName', '').size() <= 200
        && request.resource.data.get('inviterName', '') is string
        && request.resource.data.get('inviterName', '').size() <= 200
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        // 7 days from the client's clock, with room for a clock running fast.
        && request.resource.data.expiresAt <= request.time + duration.value(14, 'd')
        // getAfter: the household may be created in the same batch.
        && request.auth.uid in getAfter(householdPath(request.resource.data.householdId)).data.members
        && getAfter(householdPath(request.resource.data.householdId)).data.activeInvite == code;

      allow update: if false;

      // A member replacing or cleaning up the invite, or the partner
      // consuming it in the same transaction that adds them.
      allow delete: if signedIn()
        && request.auth.uid in getAfter(householdPath(resource.data.householdId)).data.members;
    }

    // An account's app-lock PIN record (salt:HMAC, never the PIN), so every
    // phone it signs in on opens with the same PIN (AppLockRepository).
    // Its owner's alone.
    match /users/{uid}/private/appLock {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pin', 'updatedAt'])
        && request.resource.data.pin is string
        && request.resource.data.pin.size() < 120;
    }

    match /households/{hid} {
      function isMemberOfStored() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      // Members only - a household is no longer readable by its ID alone.
      allow read: if isMemberOfStored();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['name', 'members', 'memberInfo', 'settings', 'createdBy', 'activeInvite'])
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberInfo.keys().hasOnly([request.auth.uid]);

      allow update: if signedIn() && (
        // A member editing the household: name, settings, the invite and
        // their own entry in memberInfo. Membership and createdBy are fixed.
        (
          isMemberOfStored()
          && onlyChanges(['name', 'settings', 'memberInfo', 'activeInvite'])
          && request.resource.data.memberInfo.diff(resource.data.memberInfo)
               .affectedKeys().hasOnly([request.auth.uid])
        )
        // A member leaving: removes only themselves.
        || (
          isMemberOfStored()
          && onlyChanges(['members', 'memberInfo'])
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.memberInfo.diff(resource.data.memberInfo)
               .affectedKeys().hasOnly([request.auth.uid])
        )
        // The partner joining with a valid, unexpired invite for this
        // household while there's room (max 2 members).
        || (
          !isMemberOfStored()
          && resource.data.members.size() < 2
          && onlyChanges(['members', 'memberInfo', 'joinedVia', 'activeInvite'])
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && request.resource.data.memberInfo.diff(resource.data.memberInfo)
               .affectedKeys().hasOnly([request.auth.uid])
          && get(/databases/$(db)/documents/invites/$(request.resource.data.joinedVia)).data.householdId == hid
          && get(/databases/$(db)/documents/invites/$(request.resource.data.joinedVia)).data.expiresAt > request.time
        )
      );

      // Only the last member, once every subcollection is emptied (see
      // HouseholdRepository._wipeHousehold).
      allow delete: if isMemberOfStored() && resource.data.members.size() == 1;

      function isMember() {
        return signedIn() && request.auth.uid in get(householdPath(hid)).data.members;
      }

      function isSoleMember() {
        return isMember() && get(householdPath(hid)).data.members.size() == 1;
      }

      // Records attributed to whoever created them: createdBy is set to the
      // writer on create and never changes after.
      function attributedCreate() {
        return isMember() && request.resource.data.createdBy == request.auth.uid;
      }

      function attributedUpdate() {
        return isMember()
          && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
      }

      // Shape checks run on the document as it ends up after the write, so a
      // partial update (an account's balance alone) passes as long as the
      // result is still well-formed. Each model's toFirestore() writes every
      // field, so all of them are required.
      function hasExactly(keys) {
        return request.resource.data.keys().hasOnly(keys)
          && request.resource.data.keys().hasAll(keys);
      }

      // For fields added after documents already existed: the app always
      // writes them, but an older document without them must still accept a
      // partial update (CategoryRepository.reassign touches categoryId only).
      function hasFields(required, optional) {
        return request.resource.data.keys().hasOnly(required.concat(optional))
          && request.resource.data.keys().hasAll(required);
      }

      function text(v, max) {
        return v is string && v.size() <= max;
      }

      // HouseholdCrypto.encryptAmount: base64url of a 12-byte nonce, the
      // amount's digits and a 16-byte MAC.
      function encryptedAmount(v) {
        return v is string && v.size() >= 40 && v.size() <= 100;
      }

      function validCategory() {
        let d = request.resource.data;
        return hasFields(['name', 'type', 'icon', 'color', 'createdBy'], ['rollover'])
          && text(d.name, 200)
          && d.type in ['ingreso', 'factura', 'gasto', 'ahorro']
          && text(d.icon, 50)
          && d.color is int
          && d.get('rollover', false) is bool;
      }

      // lib/core/balance/balance_ledger.dart: each device's share of the
      // balance, keyed by device. Rules can't loop, so only the map's size
      // is bounded.
      function deviceBalances(d) {
        return d.get('deviceBalances', {}) is map && d.get('deviceBalances', {}).size() <= 50;
      }

      function validAccount() {
        let d = request.resource.data;
        return hasFields(['name', 'type', 'balance', 'includeInAvailable', 'createdBy'],
                         ['deviceBalances'])
          && text(d.name, 200)
          && d.type in ['efectivo', 'banco', 'billetera', 'debito']
          && encryptedAmount(d.balance)
          && deviceBalances(d)
          && d.includeInAvailable is bool;
      }

      // year/month aren't checked against date: they're the device's local
      // calendar, the timestamp is UTC.
      // Mirrors maxTagsPerMovement in lib/features/transactions/data/tags.dart.
      function maxTags() {
        return 10;
      }

      function validTransaction() {
        let d = request.resource.data;
        return hasFields(['amount', 'type', 'categoryId', 'accountId', 'cardDebtId',
                          'description', 'date', 'year', 'month', 'createdBy'],
                         ['paidBy', 'tags'])
          && encryptedAmount(d.amount)
          && d.type in ['ingreso', 'factura', 'gasto', 'ahorro']
          && text(d.categoryId, 100)
          && text(d.accountId, 100)
          && text(d.cardDebtId, 100)
          && text(d.description, 1000)
          && text(d.get('paidBy', ''), 128)
          && d.get('tags', []) is list && d.get('tags', []).size() <= maxTags()
          && d.date is timestamp
          && d.year is int
          && d.month is int && d.month >= 1 && d.month <= 12;
      }

      // Days and installments aren't range-checked: the edit screen doesn't
      // bound them either, and a rejected save would just look broken.
      function validDebt() {
        let d = request.resource.data;
        return hasFields(['name', 'type', 'balance', 'hasBalance', 'rate', 'paymentDay',
                          'creditLimit', 'minPayment', 'extraPayment', 'cutoffDay',
                          'originalAmount', 'monthlyPayment', 'termMonths',
                          'paidInstallments', 'createdBy'],
                         ['deviceBalances'])
          && text(d.name, 200)
          && d.type in ['tarjeta', 'credito', 'hipoteca', 'vehiculo']
          && encryptedAmount(d.balance)
          && deviceBalances(d)
          && d.hasBalance is bool
          && d.rate is number
          && d.paymentDay is int
          && encryptedAmount(d.creditLimit)
          && encryptedAmount(d.minPayment)
          && encryptedAmount(d.extraPayment)
          && d.cutoffDay is int
          && encryptedAmount(d.originalAmount)
          && encryptedAmount(d.monthlyPayment)
          && d.termMonths is int
          && d.paidInstallments is int;
      }

      // Rules can't loop over the contributions, so only the list itself is
      // checked.
      function validSavingsGoal() {
        let d = request.resource.data;
        return hasExactly(['name', 'iconSlug', 'targetAmount', 'targetDate',
                           'monthlyContribution', 'interestRate', 'contributions',
                           'createdBy'])
          && text(d.name, 200)
          && text(d.iconSlug, 50)
          && encryptedAmount(d.targetAmount)
          && (d.targetDate == null || d.targetDate is timestamp)
          && encryptedAmount(d.monthlyContribution)
          && d.interestRate is number
          && d.contributions is list;
      }

      match /categories/{docId} {
        allow read, delete: if isMember();
        allow create: if attributedCreate() && validCategory();
        allow update: if attributedUpdate() && validCategory();
      }

      match /accounts/{docId} {
        allow read, delete: if isMember();
        allow create: if attributedCreate() && validAccount();
        allow update: if attributedUpdate() && validAccount();
      }

      match /transactions/{docId} {
        allow read, delete: if isMember();
        allow create: if attributedCreate() && validTransaction();
        allow update: if attributedUpdate() && validTransaction();
      }

      match /debts/{docId} {
        allow read, delete: if isMember();
        allow create: if attributedCreate() && validDebt();
        allow update: if attributedUpdate() && validDebt();
      }

      match /savingsGoals/{docId} {
        allow read, delete: if isMember();
        allow create: if attributedCreate() && validSavingsGoal();
        allow update: if attributedUpdate() && validSavingsGoal();
      }

      match /savingsChallenges/{docId} {
        allow read, delete: if isMember();
        allow create: if attributedCreate();
        allow update: if attributedUpdate();
      }

      match /transfers/{docId} {
        allow read, delete: if isMember();
        allow create: if attributedCreate();
        allow update: if attributedUpdate();
      }

      match /cardPayments/{docId} {
        allow read, delete: if isMember();
        allow create: if attributedCreate();
        allow update: if attributedUpdate();
      }

      match /recurringBills/{docId} {
        allow read, delete: if isMember();
        allow create: if attributedCreate();
        allow update: if attributedUpdate();
      }

      match /investments/{docId} {
        allow read, delete: if isMember();
        allow create: if attributedCreate();
        allow update: if attributedUpdate();
      }

      // Shared, not attributed to anyone.
      match /budgets/{docId} {
        allow read, write: if isMember();
      }

      match /monthlyNotes/{docId} {
        allow read, write: if isMember();
      }

      match /notifications/{docId} {
        allow read, write: if isMember();
      }

      // Plaintext "is X over budget / near its goal" flags a client
      // recomputes and writes at transaction/contribution time (see
      // TransactionRepository._refreshBudgetAlert and
      // SavingsGoalRepository._refreshGoalNearAlert) so the Worker's cron
      // can push about them without ever seeing the encrypted amounts.
      match /budgetAlerts/{docId} {
        allow read, write: if isMember();
      }

      match /goalAlerts/{docId} {
        allow read, write: if isMember();
      }

      // Doc ID is the push token. Each member only sees and manages their
      // own devices; the last member may clear everything when deleting the
      // household. The Worker reads these as a service account.
      match /fcmTokens/{token} {
        allow read, delete: if isMember()
          && (resource.data.uid == request.auth.uid || isSoleMember());
        allow create, update: if isMember()
          && request.resource.data.uid == request.auth.uid;
      }

      // Doc ID is the member's own uid - their scheduling prefs, mirrored
      // here for the reminder cron in cloudflare/finan2-notifications.
      match /memberPrefs/{uid} {
        allow read, delete: if isMember()
          && (uid == request.auth.uid || isSoleMember());
        allow create, update: if isMember() && uid == request.auth.uid;
      }

      // A recurring bill's date that came due, left by the Worker's cron
      // (it can't encrypt the amount itself). The first member to open the
      // app turns it into a movement and deletes it - see
      // RecurringBillScanner.confirmPending.
      match /pendingBills/{movementId} {
        allow read, delete: if isMember();
        allow create, update: if false;
      }

      // One per recurring movement ever generated, kept after the movement
      // is deleted so it isn't generated again.
      match /recurringDone/{movementId} {
        allow read, delete: if isMember();
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['doneAt'])
          && request.resource.data.doneAt is timestamp;
        allow update: if false;
      }

      // Dedup markers only the Worker writes (as a service account).
      match /sentReminders/{docId} {
        allow read, delete: if isMember();
        allow create, update: if false;
      }

      // The household key wrapped under its recovery phrase (see
      // HouseholdCrypto.wrapKeyWithRecoveryPhrase). 128 bits of phrase make
      // an offline sweep hopeless, so members can read it freely. Only a
      // device that already holds the key can produce a wrap worth anything,
      // so replacing it can't be used to read the old one.
      match /security/recovery {
        allow read, delete: if isMember();
        allow create, update: if isMember()
          && request.resource.data.keys().hasOnly(['salt', 'wrappedKey', 'createdBy', 'updatedAt'])
          // 16-byte salt and 12+32+16-byte AES-GCM box, base64url.
          && request.resource.data.salt is string
          && request.resource.data.salt.size() == 24
          && request.resource.data.wrappedKey is string
          && request.resource.data.wrappedKey.size() == 80
          && request.resource.data.createdBy == request.auth.uid;
      }
    }
  }
}
