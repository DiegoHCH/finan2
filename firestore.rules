rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /households/{hid} {
      // Members can list/read their own household.
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;

      // Any signed-in user can fetch a household by its exact ID (the invite
      // code) to join it. This does NOT allow listing/browsing households -
      // Firestore only grants this for a direct get(), not a query.
      allow get: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid];

      // A member can update freely. A non-member may only update to add
      // themselves (and only themselves), and only while the household has
      // room (max 2 members).
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (
          resource.data.members.size() < 2
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
        )
      );

      allow delete: if false;

      // Read/update/delete: any household member, for every subcollection.
      // Create is defined per-subcollection below so we can enforce
      // per-document integrity (e.g. transactions.createdBy) - a broader
      // "allow write" here would OR-bypass those checks.
      match /{subcol}/{docId} {
        allow read, update, delete: if request.auth != null
          && request.auth.uid in
             get(/databases/$(db)/documents/households/$(hid)).data.members;
      }

      function isMember() {
        return request.auth != null
          && request.auth.uid in
             get(/databases/$(db)/documents/households/$(hid)).data.members;
      }

      match /categories/{catId} {
        allow create: if isMember()
          && request.resource.data.createdBy == request.auth.uid;
      }

      match /accounts/{accId} {
        allow create: if isMember()
          && request.resource.data.createdBy == request.auth.uid;
      }

      match /transactions/{txId} {
        allow create: if isMember()
          && request.resource.data.createdBy == request.auth.uid;
      }

      match /debts/{debtId} {
        allow create: if isMember()
          && request.resource.data.createdBy == request.auth.uid;
      }

      match /budgets/{budgetId} {
        allow create: if isMember();
      }

      // Plaintext "is X over budget / near its goal" flags a client
      // recomputes and writes at transaction/contribution time (see
      // TransactionRepository._refreshBudgetAlert and
      // SavingsGoalRepository._refreshGoalNearAlert) so the Worker's cron
      // can push about them without ever seeing the encrypted amounts -
      // not user-attributed, so no createdBy check.
      match /budgetAlerts/{alertId} {
        allow create: if isMember();
      }

      match /goalAlerts/{goalId} {
        allow create: if isMember();
      }

      match /savingsGoals/{goalId} {
        allow create: if isMember()
          && request.resource.data.createdBy == request.auth.uid;
      }

      match /savingsChallenges/{challengeId} {
        allow create: if isMember()
          && request.resource.data.createdBy == request.auth.uid;
      }

      match /notifications/{notificationId} {
        allow create: if isMember();
      }

      match /transfers/{transferId} {
        allow create: if isMember()
          && request.resource.data.createdBy == request.auth.uid;
      }

      match /cardPayments/{paymentId} {
        allow create: if isMember()
          && request.resource.data.createdBy == request.auth.uid;
      }

      match /recurringBills/{billId} {
        allow create: if isMember()
          && request.resource.data.createdBy == request.auth.uid;
      }

      match /investments/{investmentId} {
        allow create: if isMember()
          && request.resource.data.createdBy == request.auth.uid;
      }

      match /monthlyNotes/{noteId} {
        allow create: if isMember();
      }

      match /fcmTokens/{token} {
        allow create: if isMember()
          && request.resource.data.uid == request.auth.uid;
      }

      // Doc ID is the member's own uid - only they can create/overwrite
      // their own scheduling prefs, mirrored here so the reminder Cron
      // Trigger in cloudflare/finan2-notifications/worker.js can read them
      // (it authenticates as a service account, which isn't subject to
      // these rules at all - this only gates the client SDK writes).
      match /memberPrefs/{uid} {
        allow create: if isMember() && uid == request.auth.uid;
      }
    }
  }
}
