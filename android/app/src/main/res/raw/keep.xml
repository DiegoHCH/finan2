<?xml version="1.0" encoding="utf-8"?>
<!-- google_sign_in looks this up by name at runtime, so the release
     resource shrinker can't see it's used and drops it: Google sign-in then
     fails before the account picker, only in builds from Play. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/default_web_client_id" />
